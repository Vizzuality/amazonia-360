    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" node --env-file-if-exists=.env.local ./node_modules/payload/bin.js build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env.local ./node_modules/srvx/bin/srvx.mjs --prod --port=3100 --dir=. --static=dist/client --entry=dist/server/server.js",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env.local ./node_modules/payload/bin.js",
    "generate:importmap": "pnpm payload generate:importmap",
    "generate:types": "pnpm payload generate:types",
    "test": "vitest run",
    "test:integration": "vitest run --config integration/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
