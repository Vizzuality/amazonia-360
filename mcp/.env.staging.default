# Variables of the MCP HTTP server (amazonia360-mcp-http) in staging. Copy without the
# .default suffix and fill in; never commit the filled copy. Settings in README.md.

# Secret. The OAuth client of Google Cloud whose authorised redirects include
# https://<staging host>/mcp/oauth/callback.
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=

# Secret. The staging database, as the mcp role (its own role and schema, not
# Payload's): postgresql://mcp:<password>@<host>:5432/<database>. Generate the
# password where the role is created (Terraform random_password), do not send it.
MCP_DATABASE_URL=

# Public HTTPS URL of the server, without a trailing slash; plain http is refused
# outside localhost. Example: https://<staging host>/mcp
MCP_PUBLIC_URL=

# Optional, defaults in README.md.
# MCP_CALL_LOG=var/calls.jsonl
# ARCGIS_TIMEOUT_S=65
# MCP_PORT=8000
# MCP_ALLOWED_REDIRECT_URIS=

# Who can sign in is not set here: it is the table mcp.allowed_emails, filled with
#   amazonia360-mcp-db upgrade
#   amazonia360-mcp-db allow <email>
# after the migration and before anyone signs in.
