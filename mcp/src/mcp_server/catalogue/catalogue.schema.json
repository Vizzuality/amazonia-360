{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Caveat": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Caveat",
      "type": "object"
    },
    "FeatureResource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "feature",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "url",
        "layer_id"
      ],
      "title": "FeatureResource",
      "type": "object"
    },
    "ImageryResource": {
      "additionalProperties": false,
      "description": "An image service, as Payload's imagery block holds it.\n\nraster_function is the front end's, in the JS SDK's form. When it is a Colormap,\nits entries are the classes, in the legend's order. A function the MCP cannot\nread by class still loads: raster_problem() says why, and the indicator reports\nitself unavailable instead of stopping the whole catalogue.",
      "properties": {
        "type": {
          "const": "imagery",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "raster_function": {
          "additionalProperties": true,
          "title": "Raster Function",
          "type": "object"
        },
        "legend": {
          "$ref": "#/$defs/Legend"
        },
        "aggregation": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "mean",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation"
        }
      },
      "required": [
        "type",
        "url",
        "raster_function",
        "legend"
      ],
      "title": "ImageryResource",
      "type": "object"
    },
    "IndicatorMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description_short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Short"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Markdown.",
          "title": "Description"
        },
        "subtopic": {
          "title": "Subtopic",
          "type": "integer"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "country": {
          "anyOf": [
            {
              "enum": [
                "ECU",
                "BOL",
                "BRA",
                "COL",
                "GUF",
                "GUY",
                "PER",
                "SUR",
                "VEN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "resource": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "feature": "#/$defs/FeatureResource",
                  "imagery": "#/$defs/ImageryResource"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/FeatureResource"
                },
                {
                  "$ref": "#/$defs/ImageryResource"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "value_type": {
          "anyOf": [
            {
              "enum": [
                "count",
                "area",
                "length",
                "distance",
                "ratio",
                "index",
                "density",
                "categorical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Type"
        },
        "aggregation": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "mean",
                "area_weighted_mean",
                "min",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation"
        },
        "decimals": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimals"
        },
        "spatial_coverage": {
          "default": [],
          "items": {
            "enum": [
              "ECU",
              "BOL",
              "BRA",
              "COL",
              "GUF",
              "GUY",
              "PER",
              "SUR",
              "VEN"
            ],
            "type": "string"
          },
          "title": "Spatial Coverage",
          "type": "array"
        },
        "collected_at_level": {
          "anyOf": [
            {
              "enum": [
                "0",
                "1",
                "2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At Level"
        },
        "sensitivity": {
          "anyOf": [
            {
              "enum": [
                "public",
                "restricted",
                "restricted_review",
                "indigenous_data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "ai_answerable": {
          "default": false,
          "title": "Ai Answerable",
          "type": "boolean"
        },
        "caveats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Caveat"
          },
          "title": "Caveats",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "source_org": null,
            "source_url": null,
            "license": null,
            "source_citation": null,
            "data_vintage": null,
            "update_cadence": null,
            "method_url": null
          }
        },
        "category_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The attribute that holds each feature's class, used to list and group by class. Belongs in Payload's feature resource block, next to layer_id. Proposal: not in the CMS contract yet.",
          "title": "Category Field"
        },
        "covers_module": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the layer's features cover the whole module, so that every point falls in some class. Tells an empty answer that means 'nothing mapped here' from one that should not happen. Would sit next to spatial_coverage. Proposal: not in the CMS contract yet.",
          "title": "Covers Module"
        },
        "documented_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Records the source documentation says the layer has. Compared with sync.published_count to warn about a mismatch. Belongs in Payload's provenance group. Proposal: not in the CMS contract yet.",
          "title": "Documented Count"
        },
        "sync": {
          "$ref": "#/$defs/Sync",
          "default": {
            "arcgis_item_id": null,
            "queryable_fields": null,
            "layer_last_edit": null,
            "schema_last_edit": null,
            "item_modified": null,
            "synced_at": null,
            "sync_status": null,
            "published_count": null,
            "pixel_size_deg": null
          },
          "description": "The contract's sync group (SyncFields in metadata.ts), written by the CMS's ArcGIS sync job and sent with the rest of the indicator. Until that job exists the MCP fills it locally."
        }
      },
      "required": [
        "id",
        "name",
        "subtopic"
      ],
      "title": "IndicatorMetadata",
      "type": "object"
    },
    "Legend": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "basic",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LegendItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "Legend",
      "type": "object"
    },
    "LegendItem": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "color": {
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "label",
        "color"
      ],
      "title": "LegendItem",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_org": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Org"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "source_citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Citation"
        },
        "data_vintage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Vintage"
        },
        "update_cadence": {
          "anyOf": [
            {
              "enum": [
                "monthly",
                "quarterly",
                "biannual",
                "annual",
                "irregular",
                "one_off",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Cadence"
        },
        "method_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Url"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Sync": {
      "additionalProperties": false,
      "properties": {
        "arcgis_item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arcgis Item Id"
        },
        "queryable_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queryable Fields"
        },
        "layer_last_edit": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Last Edit"
        },
        "schema_last_edit": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Last Edit"
        },
        "item_modified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Modified"
        },
        "synced_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synced At"
        },
        "sync_status": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "error",
                "item_inaccessible"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Status"
        },
        "published_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Records in the published layer, read by the sync. Proposal: not in the CMS contract yet.",
          "title": "Published Count"
        },
        "pixel_size_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image services only: the pixel width in degrees, as the service reports it. What a share of pixels over a small area rests on, and not always what the documentation says. Proposal: not in the CMS contract yet.",
          "title": "Pixel Size Deg"
        }
      },
      "title": "Sync",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole published catalogue, which the CMS exports to the MCP on every change: create, edit, publish, unpublish, delete, and each ArcGIS sync. Locale en. Not Payload's REST response: see the mapping table in the MCP README.",
  "properties": {
    "locale": {
      "const": "en",
      "title": "Locale",
      "type": "string"
    },
    "generated_at": {
      "description": "When the export was built. The MCP keeps the newest it has seen.",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "indicators": {
      "description": "Every published indicator, drafts excluded.",
      "items": {
        "$ref": "#/$defs/IndicatorMetadata"
      },
      "title": "Indicators",
      "type": "array"
    }
  },
  "required": [
    "locale",
    "generated_at",
    "indicators"
  ],
  "title": "Amazonia 360 catalogue, as the MCP takes it in",
  "type": "object"
}
