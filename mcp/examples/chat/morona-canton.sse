\n    \"source\": \"precomputed\",\n    \"layer_version\": \"2026-08-19T09:57:43.622000Z\",\n    \"pixels\": null,\n    \"to_hectares\": null,\n    \"pixel_size_deg\": null\n  },\n  \"coverage\": {\n    \"status\": \"inside\",\n    \"outside_ha\": 0.0,\n    \"boundary\": \"derived_polygon\"\n  },\n  \"place\": {\n    \"id\": \"canton:Morona Santiago/Morona\",\n    \"name\": \"Morona\",\n    \"kind\": \"canton\",\n    \"source\": \"https://services6.arcgis.com/sROlVM0rATIYgC6a/ArcGIS/rest/services/Political_administrative_division_of_order_2/FeatureServer/6\"\n  },\n  \"layer\": {\n    \"covers_module\": false,\n    \"empty_result\": null\n  },\n  \"provenance\": {\n    \"source_org\": null,\n    \"source_url\": null,\n    \"license\": null,\n    \"source_citation\": null,\n    \"data_vintage\": null,\n    \"update_cadence\": null,\n    \"method_url\": null\n  },\n  \"caveats\": [],\n  \"record_counts\": null,\n  \"aoi_ha\": 435663.1,\n  \"classified_ha\": 361462.41,\n  \"unclassified_ha\": 74200.69,\n  \"overlap_ha\": null,\n  \"unclassified_share\": null,\n  \"timing\": {\n    \"total_ms\": 174,\n    \"arcgis_ms\": 0,\n    \"store_ms\": 1,\n    \"clip_ms\": 0,\n    \"place_ms\": 168,\n    \"vertices_sent\": 134,\n    \"vertices_received\": 0\n  }\n}"}

