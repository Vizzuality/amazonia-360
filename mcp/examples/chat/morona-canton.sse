data: {"type":"TOOL_CALL_RESULT","messageId":"f6ac056385e64b99bb8b64e44fbfda00","toolCallId":"toolu_01Ftr27BMuXeVgSao2aCFnBD","role":"tool","content":"{\n  \"indicators\": [\n    {\n      \"id\": 202,\n      \"name\": \"Areas under restoration actions (Ecuador module)\",\n      \"description_short\": \"Government inventory of areas under restoration actions inside the Ecuadorian Amazon module, with modality, practice, implementer, funding and year.\",\n      \"subtopic\": 4,\n      \"value_type\": \"count\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"count_in_area\"\n      ]\n    },\n    {\n      \"id\": 203,\n      \"name\": \"Restoration priority areas (Ecuador module)\",\n      \"description_short\": \"Very high, High, Medium and Low priority classes for forest restoration inside the Ecuadorian Amazon module.\",\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 204,\n      \"name\": \"Bioclimates (Ecuador module)\",\n      \"description_short\": \"Bioclimatic classes present in the Ecuadorian Amazon module, classified by temperature and precipitation.\",\n      \"subtopic\": 8,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 206,\n      \"name\": \"Carbon by forest stratum (Ecuador module)\",\n      \"description_short\": null,\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 208,\n      \"name\": \"Deforestation 2020-2022 (Ecuador module)\",\n      \"description_short\": \"Gross deforestation 2020-2022 in the Ecuadorian Amazon module, as land cover transition trajectories from forest to other covers.\",\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 209,\n      \"name\": \"Hydrographic Demarcations (Ecuador module)\",\n      \"description_short\": \"The three Hydrographic Demarcations of Ecuador that intersect the Amazon module: administrative territorial units for water management.\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 210,\n      \"name\": \"Ecosystems (Ecuador module)\",\n      \"description_short\": \"The 51 ecosystem classes present in the Ecuadorian Amazon module, from the Ecosystem Map of Continental Ecuador (characterised for 2012).\",\n      \"subtopic\": 5,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 211,\n      \"name\": \"Geomorphology (Ecuador module)\",\n      \"description_short\": \"The 53 geomorphological units of the Ecuadorian Amazon module, with the hierarchy Relief – Macrorelief – Mesorelief.\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 214,\n      \"name\": \"Flooding Regime (Ecuador module)\",\n      \"description_short\": \"Floodability zones and water origin in the Ecuadorian Amazon module. Floodability is a vegetation descriptor, not a hazard assessment.\",\n      \"subtopic\": 5,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 217,\n      \"name\": \"Thermotypes (Ecuador module)\",\n      \"description_short\": \"The 11 thermotypic classes present in the Ecuadorian Amazon module, related to annual maximum, minimum and mean temperatures.\",\n      \"subtopic\": 8,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 218,\n      \"name\": \"Climate Types (Ecuador module)\",\n      \"description_short\": \"The six climate types present in the Ecuadorian Amazon module, from the national climate classification.\",\n      \"subtopic\": 8,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 219,\n      \"name\": \"Biogeographic Units (Ecuador module)\",\n      \"description_short\": \"The 11 biogeographic units intersecting the Ecuadorian Amazon module, organised as region, biogeographic province and sector.\",\n      \"subtopic\": 5,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 222,\n      \"name\": \"Water Recharge Zone (Ecuador module)\",\n      \"description_short\": \"Water recharge zone clipped to the Ecuadorian Amazon module: territory able to retain, store and provide water resources.\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 7,\n      \"name\": \"Slope\",\n      \"description_short\": \"Slope ranges (degrees) Copernicus DEM\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"class_shares_in_area\"\n      ]\n    },\n    {\n      \"id\": 13,\n      \"name\": \"Land cover\",\n      \"description_short\": \"Land cover (WorldCover 2021)\",\n      \"subtopic\": 3,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"class_shares_in_area\"\n      ]\n    },\n    {\n      \"id\": 119,\n      \"name\": \"Forest Cover\",\n      \"description_short\": \"Forest cover analysis, percentage per 1km² grid cell (GLAD 2024)\",\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"class_shares_in_area\"\n      ]\n    },\n    {\n      \"id\": 128,\n      \"name\": \"Grassland Coverage Classes\",\n      \"description_short\": \"Grassland cover classes, GPW 2024 model\",\n      \"subtopic\": 6,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"class_shares_in_area\"\n      ]\n    },\n    {\n      \"id\": 129,\n      \"name\": \"Canopy height\",\n      \"description_short\": \"Estimated tree canopy height, m (Ctrees, 2024)\",\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"class_shares_in_area\"\n      ]\n    }\n  ]\n}"}

