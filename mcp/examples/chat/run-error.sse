ion_short\": \"Gross deforestation 2020-2022 in the Ecuadorian Amazon module, as land cover transition trajectories from forest to other covers.\",\n      \"subtopic\": 4,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 209,\n      \"name\": \"Hydrographic Demarcations (Ecuador module)\",\n      \"description_short\": \"The three Hydrographic Demarcations of Ecuador that intersect the Amazon module: administrative territorial units for water management.\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 210,\n      \"name\": \"Ecosystems (Ecuador module)\",\n      \"description_short\": \"The 51 ecosystem classes present in the Ecuadorian Amazon module, from the Ecosystem Map of Continental Ecuador (characterised for 2012).\",\n      \"subtopic\": 5,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 211,\n      \"name\": \"Geomorphology (Ecuador module)\",\n      \"description_short\": \"The 53 geomorphological units of the Ecuadorian Amazon module, with the hierarchy Relief – Macrorelief – Mesorelief.\",\n      \"subtopic\": 1,\n      \"value_type\": \"categorical\",\n      \"ai_answerable\": true,\n      \"available\": true,\n      \"tools\": [\n        \"categories_in_area\",\n        \"area_by_category\"\n      ]\n    },\n    {\n      \"id\": 214,\n      \"name\": \"Flooding Regime (Ecuador module)\",\n      \"description_short\": \"Floodability zones and water origin in the Ecuadorian Amazon module. Floodability is a vegetation