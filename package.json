{
  "name": "amazonia-360",
  "version": "0.2.0",
  "description": "Amazonia 360 platform",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "clean": "rimraf dist coverage .next && pnpm -r --filter=!ai-explorations clean",
    "lint": "pnpm -r --filter=!ai-explorations lint",
    "format": "pnpm -r --filter=!ai-explorations format",
    "check": "pnpm -r --filter=!ai-explorations check",
    "build": "pnpm -r --filter=!ai-explorations build",
    "test": "pnpm -r --filter=!ai-explorations test",
    "splitenv": "node scripts/splitenv.mts .env API CLIENT DATABASE LOAD_TESTS",
    "test:splitenv": "vitest run scripts/splitenv.test.mts"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "typescript": "5.8.2",
    "vitest": "4.1.11"
  }
}
