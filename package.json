{
  "name": "amazonia-360",
  "version": "0.2.0",
  "description": "Amazonia 360 platform",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "clean": "rimraf dist coverage .next && pnpm -r clean",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "splitenv": "node scripts/splitenv.mts .env API CLIENT DATABASE LOAD_TESTS",
    "test:splitenv": "vitest run scripts/splitenv.test.mts"
  },
  "pnpm": {
    "overrides": {
      "vite>picomatch": "4.0.4",
      "vite>yaml": "2.8.3",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9"
    }
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "3.2.7",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  }
}
